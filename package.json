{
  "name": "paseo-task-manager",
  "private": true,
  "version": "1.0.0",
  "description": "Paseo plugin for user-created task boards with explicit agent launching.",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/nerveband/paseo-task-manager.git" },
  "keywords": ["paseo", "paseo-plugin", "task-manager", "task-board", "coding-agents"],
  "engines": { "node": ">=24" },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "check": "npm run typecheck && npm test",
    "verify": "node scripts/check-package.mjs && node scripts/check-docs.mjs && node scripts/check-secrets.mjs"
  },
  "devDependencies": {
    "@getpaseo/client": "0.8.0-beta.1",
    "@getpaseo/plugin": "0.8.0-beta.1",
    "@tanstack/react-query": "^5.90.11",
    "@types/node": "^22.10.0",
    "@types/react": "~19.2.0",
    "esbuild": "0.28.2",
    "puppeteer": "25.11.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-web": "0.21.2",
    "semver": "7.8.5",
    "tsx": "^4.19.3",
    "typescript": "^5.9.3",
    "zod": "^4.4.3"
  }
}
